# ── deploy/.env — production Caddy stack ─────────────────────────────
#
#   cd deploy
#   cp .env.example .env
#   # fill in the values below, then:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Compose reads this file twice, on purpose:
#   * for `${VAR}` interpolation inside docker-compose.prod.yml (explicit
#     secret mapping — a missing SERVER_SECRET aborts `up` instead of
#     silently starting with a random one), and
#   * via `env_file:` so anything else you add here reaches the container.
#
# NEVER commit the resulting .env — deploy/.env is covered by the repo
# .gitignore rule for `.env`.

# ── Required ─────────────────────────────────────────────────────────
# Exactly 64 hex characters (32 decoded bytes), generated once. Rotation
# invalidates passcode identity HMACs and TURN identifiers; drain active
# sessions/credentials and rotate all signaling instances together.
#   openssl rand -hex 32
SERVER_SECRET=

# ── Cloudflare Realtime TURN (required when TURN_AUTO_ENABLED=true) ──
# Dashboard → Realtime → TURN. Account Tag is the sidebar Account ID.
# TURN_CF_API_TOKEN needs `TURN:Edit` (issue/revoke). Startup validation
# only requires this issuing token.
TURN_CF_KEY_ID=
TURN_CF_API_TOKEN=
TURN_CF_ACCOUNT_TAG=
# Optional read-only token for GraphQL Analytics polling. Falls back to
# TURN_CF_API_TOKEN when unset. Split least privilege with
# `Account Analytics:Read` here and keep issue/revoke on TURN_CF_API_TOKEN.
#TURN_CF_ANALYTICS_API_TOKEN=

# Set to false to run without server-issued relays (clients then only get
# the manual TURN servers they configure in Settings).
TURN_AUTO_ENABLED=true

# ── Optional ─────────────────────────────────────────────────────────
# Origin policy:
#   line absent / commented  → public-signaling mode (any browser origin)
#   ALLOWED_ORIGINS=a,b      → strict mode, only those origins
#   ALLOWED_ORIGINS=         → explicit lockdown: NO browser origin allowed
#ALLOWED_ORIGINS=https://misaka.example

# Any other variable from server/.env.example can be added here; it is
# passed straight through to the container. Values hard-coded in
# docker-compose.prod.yml `environment:` take precedence over this file.
