# ── Misaka 信令服务器配置 ─────────────────────────────────────────────
#
# 复制为 server/.env 后按需修改：
#
#   cp server/.env.example server/.env
#
# 谁会读这个文件？`server/src/bootstrap.ts` —— 也就是 `npm run dev`、
# `npm start` 和 Docker 镜像 CMD 共同的启动入口。加载顺序为：
#
#   1. $MISAKA_ENV_FILE   显式指定的文件（可选）
#   2. server/.env        本文件的副本
#   3. <仓库根>/.env      docker-compose.yml 用 env_file 引用的同一份密钥
#
# 已经存在于进程环境中的变量永远优先（Compose 的 `environment:` 会覆盖
# 文件内容）。集成测试与 Playwright 直接启动 `dist/index.js`，刻意不读任何
# .env，避免开发者的本地文件污染测试。
#
# 注意：服务器启动时会对下列数值做 finite/范围校验并在非法时 fail fast，
# 所以「留空但保留等号」的写法对数值项是非法的 —— 不需要就整行注释掉。

# ── HTTP / 进程 ───────────────────────────────────────────────────────
# 监听端口 (default: 9080)。Dockerfile EXPOSE / compose 端口映射同为 9080。
PORT=9080

# 反向代理跳数。默认 0/false = 不信任任何 X-Forwarded-For。
# 只有当服务恰好位于 N 层「会重写 XFF 的可信代理」之后时才设置为 N。
# deploy/ 的 Caddy 模板正好是一跳 → TRUST_PROXY=1。
# 直接暴露在公网（无代理）时必须保持关闭，否则每个 per-IP 防线都可被伪造头绕过。
#TRUST_PROXY=1

# 允许的浏览器 Origin。留空/不设置 = 公共信令模式（接受任意 Origin）。
# 私有部署写成逗号分隔白名单：
#ALLOWED_ORIGINS=https://frontend.example,https://other.example

# ── 节点与会话 ────────────────────────────────────────────────────────
# 全局节点上限 (default: 5000)。0 = 显式解除上限——但 activity 广播和内存
# 占用都随人口增长，公网部署请保留一个有限值。
MAX_NODES=10000

# API 每分钟限流次数 (default: 60)
RATE_LIMIT_PER_MIN=60

# 登录 token 有效期，单位毫秒 (default: 1800000 = 30 分钟)
SESSION_TTL_MS=1800000

# WS 建连后必须在多少毫秒内发送 AUTH，否则以 4001 关闭 (default: 5000)
WS_AUTH_GRACE_MS=5000

# ── 安全 ──────────────────────────────────────────────────────────────
# customIdentifier 派生用的稳定密钥。不设置时每个进程随机生成并告警，
# 重启后 Cloudflare 侧的历史记录无法关联、revoke 重试也会失效。
# 生产必须设置为一个固定的高熵值：openssl rand -hex 32
#SERVER_SECRET=

# per-nodeId 全局暴破冻结：WINDOW_MS 内累计 THRESHOLD 次失败即冻结 DURATION_MS。
NODE_FREEZE_THRESHOLD=20
NODE_FREEZE_WINDOW_MS=3600000
NODE_FREEZE_DURATION_MS=3600000

# qr-redeem 每 IP 每分钟限流 (default: 10)
QR_REDEEM_RATE_LIMIT=10

# /api/transfer-done 上报的字节数上限与每 IP 每分钟限流。
# 这是公开统计的防伪造边界：超过上限的上报以 400 拒绝。
MAX_TRANSFER_BYTES=68719476736               # 64 GiB
TRANSFER_DONE_RATE_LIMIT=60

# ── WebSocket 资源边界 ────────────────────────────────────────────────
# WS_MAX_PAYLOAD_BYTES 是交给 `ws` 的传输层上限：超限帧在完整缓冲进内存
# 之前就被中止（1009）。WS_MAX_MESSAGE_BYTES 是应用层策略上限，默认与之
# 相同；累计 WS_MAX_OVERSIZE_STRIKES 次超限后断开该 socket。
WS_MAX_MESSAGE_BYTES=65536                   # 64 KiB
#WS_MAX_PAYLOAD_BYTES=65536
WS_MAX_OVERSIZE_STRIKES=3

# 每 socket 入站令牌桶：允许 WS_MSG_BURST 条突发（ICE trickle 确实会突发），
# 按 WS_MSG_RATE_PER_SEC 补充；超预算的帧被丢弃，累计 WS_MAX_RATE_VIOLATIONS
# 次后以 1008 关闭。
WS_MSG_BURST=240
WS_MSG_RATE_PER_SEC=60
WS_MAX_RATE_VIOLATIONS=200

# 慢读者出站背压：软水位以上停止向该 socket 转发，超过硬水位或在软水位以上
# 卡满 grace 时间即断开，避免发送队列无界增长。
WS_MAX_BUFFERED_BYTES=1048576                # 1 MiB
WS_MAX_BUFFERED_HARD_BYTES=8388608           # 8 MiB
WS_SLOW_CONSUMER_GRACE_MS=10000

# activity 广播的每秒预算。
ACTIVITY_MAX_PER_SEC=20

# scrypt 校验并发预算。注册散列走 libuv 线程池，同时在跑的最多
# SCRYPT_MAX_CONCURRENT 个、排队最多 SCRYPT_MAX_QUEUE 个；
# 超出后 /api/register 返回 503 SERVER_BUSY（可重试），而不是阻塞事件循环。
SCRYPT_MAX_CONCURRENT=4
SCRYPT_MAX_QUEUE=64

# ── TURN 自动下发（Cloudflare Realtime TURN）─────────────────────────
# 总开关。false = 服务端完全不下发 TURN，客户端只能用设置里手工填的中继。
TURN_AUTO_ENABLED=true
TURN_PROVIDER=cloudflare

# 凭据（Cloudflare Dashboard → Realtime → TURN）。TURN_AUTO_ENABLED=true 时必填。
# API Token 至少需要 `TURN:Edit` + `Account Analytics:Read`。
#TURN_CF_KEY_ID=
#TURN_CF_API_TOKEN=
#TURN_CF_ACCOUNT_TAG=

# 单个凭据有效期（秒）。短 TTL 是 revoke 调用失败时的兜底。
TURN_CREDENTIAL_TTL_SEC=300

# 每 session / 每 IP 防滥用上限。
TURN_MAX_BYTES_PER_SESSION=1073741824        # 1 GiB
TURN_MAX_BYTES_PER_HOUR_PER_IP=10737418240   # 10 GiB
TURN_MAX_ISSUE_PER_HOUR_PER_IP=60

# 全局月度熔断（守住 Cloudflare 免费额度）。
TURN_GLOBAL_MONTHLY_BYTES_LIMIT=1099511627776  # 1 TiB
TURN_GLOBAL_THRESHOLD_PCT=90
TURN_REVOKE_ALL_ON_KILL=false

# CF Analytics 有 1~5 分钟延迟，用悲观估算做零延迟快路径（bit/s）。
TURN_PESSIMISTIC_RATE_BPS=10000000           # 10 Mbps

# 轮询周期（秒）。
TURN_ABUSE_POLL_SEC=30
TURN_GLOBAL_POLL_SEC=120

# 失败的 CF revoke 调用的重试间隔（毫秒）。
TURN_REVOKE_RETRY_INTERVAL_MS=60000

# ── 持久化 ────────────────────────────────────────────────────────────
# TURN 状态（月度字节、活动凭据、签发历史）与暴破锁快照的落盘目录。
# Docker 内固定为 /app/data，并由 compose 挂载到宿主机；本地开发默认 ./data。
TURN_PERSIST_DIR=./data
TURN_PERSIST_INTERVAL_SEC=10
