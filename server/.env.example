# ── Misaka 信令服务器配置 ─────────────────────────────────────────────
# 复制为 .env 后按需修改。未设置的项将使用括号内的默认值。

# 监听端口 (default: 9080)
PORT=9080

# 全局节点上限，0 表示不限制 (default: 不限制)
MAX_NODES=10000

# API 每分钟限流次数 (default: 60)
RATE_LIMIT_PER_MIN=60

# 登录 token 有效期，单位毫秒 (default: 1800000 = 30 分钟)
SESSION_TTL_MS=1800000
