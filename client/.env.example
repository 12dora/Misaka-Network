# ── Misaka Client Configuration ────────────────────────────────────
# Copy to .env and edit for local development.
#
# For production (GitHub Pages), edit public/config.json instead.
#
# Priority: config.json > Vite env vars > defaults

# API base URL (leave empty for same-origin / Vite proxy)
VITE_API_BASE=

# WebSocket URL (leave empty for same-origin)
VITE_WS_URL=

# ── Deployment base ────────────────────────────────────────────────
# VITE_BASE is the SINGLE source of truth for where the app is mounted.
# vite.config.ts feeds it to Vite's `base`, which produces:
#   * the asset URLs in dist/index.html
#   * import.meta.env.BASE_URL → the router basename and every absolute
#     link the app hands out (src/lib/appBase.ts)
#   * the redirect target substituted into dist/404.html
# Never hard-code a repo path in any of those places again.
#
# Unset (default) → './' : relative assets, routing treated as origin root.
#                          Correct for a custom domain or a self-hosted root.
# '/'             → absolute assets at the origin root.
# '/my-repo/'     → GitHub Pages project site served under /my-repo/.
#
# CI does NOT need you to set this: .github/workflows/deploy.yml derives it
# from the actual Pages base path (repository name, or '/' for a custom
# domain). Set it by hand only for a local subpath build:
#   VITE_BASE=/my-repo/ npm run build
#
# Verify a subpath build with:  VITE_BASE=/subpath-smoke/ npm run build:subpath
#VITE_BASE=/
# VITE_BASE is the only deployment base. There is no VITE_APP_BASE / APP_BASE.
