{
  "name": "misaka-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:subpath": "vite build --outDir dist-subpath-smoke --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:config": "tsc --noEmit -p tsconfig.config.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "npm run test:unit && npm run test:contract",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:contract": "node tests/ui-contract.test.mjs",
    "test:e2e": "playwright test",
    "test:manual": "node tests/manual-test.mjs"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.16",
    "jsdom": "^29.1.1",
    "pngjs": "^5.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^4.1.6"
  }
}
