# Cloudflare Realtime TURN — required for auto TURN delivery.
# Do NOT commit a real .env file. .env is gitignored.
#
# How to obtain:
#   1. Sign in to Cloudflare dashboard → Realtime → TURN
#   2. Create a TURN key — copy the Key ID (TURN_CF_KEY_ID) and the API token
#      (TURN_CF_API_TOKEN). Token needs `TURN:Edit` + `Account Analytics:Read`
#      so the server can both issue/revoke credentials and read usage.
#   3. Account Tag (TURN_CF_ACCOUNT_TAG) is on the dashboard right sidebar.

TURN_CF_KEY_ID=
TURN_CF_API_TOKEN=
TURN_CF_ACCOUNT_TAG=
