# Cloudflare Realtime TURN — required for auto TURN delivery.
# Do NOT commit a real .env file. .env is gitignored.
#
# How to obtain:
#   1. Sign in to Cloudflare dashboard → Realtime → TURN
#   2. Create a TURN key — copy the Key ID (TURN_CF_KEY_ID) and the API token
#      (TURN_CF_API_TOKEN). Token needs at least `TURN:Edit` for issue/revoke.
#      Startup validation requires only this issuing token.
#   3. Account Tag (TURN_CF_ACCOUNT_TAG) is on the dashboard right sidebar.
#   4. Optional: TURN_CF_ANALYTICS_API_TOKEN for GraphQL usage polling only
#      (`Account Analytics:Read`). Falls back to TURN_CF_API_TOKEN when unset.

TURN_CF_KEY_ID=
TURN_CF_API_TOKEN=
TURN_CF_ACCOUNT_TAG=
#TURN_CF_ANALYTICS_API_TOKEN=

# ── Security & operations (added 2026-05-24) ───────────────────────────
# Origin policy.
#
#   ALLOWED_ORIGINS unset (DEFAULT)  → Public-signaling mode. Server
#     accepts requests from ANY browser origin. This is the canonical
#     deployment (public misaka.konata.tv that arbitrary GitHub-Pages
#     forks point at). Cross-site CSRF risk is mitigated by scrypt
#     passcodes + per-nodeId global brute-force freeze + per-IP rate
#     limits. Leave this line commented out for the public deployment.
#
#   ALLOWED_ORIGINS=*                → Same as unset (explicit form).
#
#   ALLOWED_ORIGINS=https://frontend.example,https://other.example
#                                    → Strict mode. Only the listed
#     origins (plus localhost dev origins and same-origin requests) are
#     accepted. Use this for private / on-premise deployments where you
#     want a hard cross-site lock.
#
# To intentionally lock down with NO browser origins allowed, write an
# explicit list (an empty string `ALLOWED_ORIGINS=` is treated as strict
# mode with no entries, so only same-origin requests get through).
#ALLOWED_ORIGINS=

# Exactly 64 hex characters (32 decoded bytes). Production refuses missing or
# weak values. Rotation changes passcode identity HMACs and TURN identifiers:
# drain sessions/credentials, rotate all instances together, then restart.
SERVER_SECRET=

# WS auth grace window. Sockets that don't send AUTH within this many ms
# are force-closed (code 4001). Stops anonymous-WS resource exhaustion.
WS_AUTH_GRACE_MS=5000

# Per-nodeId global brute-force freeze: if THRESHOLD failed attempts
# accumulate from any IPs within WINDOW_MS, the nodeId is frozen for
# DURATION_MS. Protects against IP-rotating credential stuffing.
NODE_FREEZE_THRESHOLD=20
NODE_FREEZE_WINDOW_MS=3600000
NODE_FREEZE_DURATION_MS=3600000

# qr-redeem rate limit (per IP, per minute).
QR_REDEEM_RATE_LIMIT=10

# Interval between retries of CF TURN revoke calls that previously failed.
TURN_REVOKE_RETRY_INTERVAL_MS=60000
