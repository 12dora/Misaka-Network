# Cloudflare Realtime TURN — required for auto TURN delivery.
# Do NOT commit a real .env file. .env is gitignored.
#
# How to obtain:
#   1. Sign in to Cloudflare dashboard → Realtime → TURN
#   2. Create a TURN key — copy the Key ID (TURN_CF_KEY_ID) and the API token
#      (TURN_CF_API_TOKEN). Token needs `TURN:Edit` + `Account Analytics:Read`
#      so the server can both issue/revoke credentials and read usage.
#   3. Account Tag (TURN_CF_ACCOUNT_TAG) is on the dashboard right sidebar.

TURN_CF_KEY_ID=
TURN_CF_API_TOKEN=
TURN_CF_ACCOUNT_TAG=

# ── Security & operations (added 2026-05-24) ───────────────────────────
# Comma-separated origin whitelist. WS upgrades and /api/register reject
# anything not in this list. Defaults include localhost dev origins.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Stable secret for customIdentifier derivation. If unset, server generates
# a random one per-process — fine in dev but CF identifiers rotate on
# every restart in prod, breaking revoke retries.
SERVER_SECRET=

# WS auth grace window. Sockets that don't send AUTH within this many ms
# are force-closed (code 4001). Stops anonymous-WS resource exhaustion.
WS_AUTH_GRACE_MS=5000

# Per-nodeId global brute-force freeze: if THRESHOLD failed attempts
# accumulate from any IPs within WINDOW_MS, the nodeId is frozen for
# DURATION_MS. Protects against IP-rotating credential stuffing.
NODE_FREEZE_THRESHOLD=20
NODE_FREEZE_WINDOW_MS=3600000
NODE_FREEZE_DURATION_MS=3600000

# qr-redeem rate limit (per IP, per minute).
QR_REDEEM_RATE_LIMIT=10

# Interval between retries of CF TURN revoke calls that previously failed.
TURN_REVOKE_RETRY_INTERVAL_MS=60000
